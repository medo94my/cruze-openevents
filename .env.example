# Cruze Events — local development example ONLY
# Copy to .env.local; set YOUR OWN local/disposable credentials.
# Never commit any real password, API key, token, or database URL.
# Production variables are configured in Vercel and provider dashboards.

NODE_ENV=development
APP_NAME=Cruze Events
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
DEFAULT_CURRENCY=QAR

# Use a separate, disposable development PostgreSQL database.
DATABASE_URL=

# Vercel Blob (required for event/speaker uploads in current Cruze UI).
# Provision an independent development Blob token; never copy production secrets.
BLOB_READ_WRITE_TOKEN=

# Legacy S3/MinIO support remains in inherited routes.
# Only configure if intentionally testing those legacy routes.
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=cruze-demo-media
S3_REGION=us-east-1

# Redis integration may be required for ticket holds and order workflows.
REDIS_URL=

# Development mode prints email contents to local logs, without delivering.
EMAIL_MODE=development
EMAIL_FROM=noreply@localhost
# For actual email delivery use a tested SMTP/transactional provider.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Payment integration is not production-ready for Cruze Qatar.
# Sandbox credentials ONLY for explicit local sandbox tests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_ID=

# Verification checklist before a public launch:
# - Functional checkout with QAR-capable provider and sandbox webhooks
# - Non-public test data, idempotent orders, reliable inventory/QR scanning
# - Working email delivery, rate limits, authorization and monitoring
# - Correct Qatar tax/payment/legal behavior (do not assume upstream Swedish VAT)
